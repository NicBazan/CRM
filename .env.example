# ============================================
# CRM Ciclo Confort — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores:
#   cp .env.example .env

# === Base de Datos ===
# SQLite (desarrollo):
DATABASE_URL=sqlite:///./basedatos.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crm_db

# === Telegram ===
TELEGRAM_BOT_TOKEN=

# === LLM (Agente IA) ===
# Opciones: "gemini" o "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === CORS ===
CORS_ORIGINS=["http://localhost:5173"]

# === JWT (futuro) ===
SECRET_KEY=cambiar-en-produccion
