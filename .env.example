# ============================================
# CRM Ciclo Confort — Variables de Entorno Multicanal
# ============================================
# Copiar este archivo como .env y completar los valores:
#   cp .env.example .env

# === Entorno de Ejecución ===
# Opciones: "development" | "production" | "testing"
ENVIRONMENT=development
# Habilita los endpoints de simulación /dev (en producción se desactivan automáticamente)
ENABLE_DEV_ROUTES=true

# === Base de Datos ===
# SQLite (desarrollo):
DATABASE_URL=sqlite:///./basedatos.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crm_db

# === Telegram ===
# NUNCA subas el token de Telegram a Git.
TELEGRAM_BOT_TOKEN=
# Token secreto configurado en setWebhook de Telegram para validar origen (header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_SECRET_TOKEN=tu_token_secreto_telegram

# === Meta (WhatsApp Cloud API & Facebook Messenger) ===
# Token secreto para validar el handshake inicial con Meta (hub.verify_token)
META_VERIFY_TOKEN=tu_token_de_verificacion_aqui
# App Secret de tu Meta App para validar la firma HMAC SHA-256 (X-Hub-Signature-256)
# Obligatorio en producción para rechazar peticiones fraudulentas
META_APP_SECRET=
# Versión de la Meta Graph API
META_GRAPH_API_VERSION=v21.0

# --- WhatsApp Business Cloud API ---
# Token de acceso permanente del sistema o token de usuario de sistema en Meta Business
WHATSAPP_API_TOKEN=
# Phone Number ID asignado en el panel de desarrolladores de Meta
WHATSAPP_PHONE_NUMBER_ID=
# Opcional: remover el '9' en números móviles de Argentina (ej. 54911 -> 5411) para compatibilidad con Sandbox de Meta
WHATSAPP_ARGENTINA_STRIP_9=true

# --- Facebook Messenger ---
# Token de acceso de la Página de Facebook (Page Access Token con permisos pages_messaging)
FACEBOOK_PAGE_ACCESS_TOKEN=
# Page ID de la página de Facebook
FACEBOOK_PAGE_ID=

# === LLM (Agente IA) ===
# Opciones: "gemini" o "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === CORS ===
CORS_ORIGINS=["http://localhost:5173"]

# === Autenticación y Seguridad (JWT) ===
# OBLIGATORIO cambiar en producción por una clave aleatoria y segura:
SECRET_KEY=cambiar-en-produccion-por-un-string-seguro-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Credenciales del administrador para /auth/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# API Key opcional para integraciones directas (Header X-API-Key)
ADMIN_API_KEY=
